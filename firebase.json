{
  "hosting": {
    "site": "upigateway",
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/login.html"
      },
      {
        "source": "/user",
        "destination": "/user.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/checkout/**",
        "destination": "/checkout.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}