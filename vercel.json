{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/checkout/(.*)", "destination": "/api/index.js" },
    { "source": "/login", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/user", "destination": "/api/index.js" },
    { "source": "/dashboard", "destination": "/api/index.js" },
    { "source": "/docs", "destination": "/api/index.js" },
    { "source": "/how-to-implement", "destination": "/api/index.js" },
    { "source": "/", "destination": "/api/index.js" }
  ]
}
