{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/checkout/(.*)", "destination": "/checkout.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/user", "destination": "/user.html" },
    { "source": "/dashboard", "destination": "/user.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/how-to-implement", "destination": "/docs.html" }
  ],
  "redirects": [
    { "source": "/", "destination": "/index.html", "permanent": false }
  ]
}
